{
  "name": "@scap/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && c8 --all --include=dist/**/*.js --reporter=text --reporter=json --reporter=lcov --check-coverage --lines=100 --functions=100 --branches=100 --statements=100 node --test --test-isolation=none tests/*.test.mjs",
    "test:integration": "npm run build && node --test --test-isolation=none integration/*.test.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  },
  "devDependencies": {
    "@types/node": "24.11.0",
    "c8": "12.0.0",
    "typescript": "5.9.3"
  }
}
