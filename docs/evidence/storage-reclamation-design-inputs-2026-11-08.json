    "unimplemented_requirements": [
      "Typed segmented index and strict explicit new HEAD format, preserving original Result framing.",
      "Monotone independent storage_generation with one active/staging and no allocation reuse.",
      "Monotone head_serial separate from public revision/transition; no sealed business candidate rebinding.",
      "Bounded durable batch pins/local guards; paused pins block GC without expiry-based deletion.",
      "Freeze/Copying/Seal/Promote/Sweep with restartable bounded exact deletion plans.",
      "Repeated fair retired-range sweeps; no permanent-empty claim from finite LIST observations.",
      "Explicit retained snapshots before fresh-identity PITR."
    ],
    "liveness_assumptions": [
      "Finite old operations, no fresh old-generation admission, each prior PUT eventually terminates.",
      "Storage available; fair complete repeated scans of all retired ranges.",
      "Retained snapshot and database identity sets bounded; catalogue identity growth has separate contract.",
      "Paused pins explicitly released or separately proven quiescence/revocation; TTL insufficient.",
      "Continuous-load reclamation capacity exceeds garbage production with copy reserve.",
      "After quiescence, current-generation orphans may require a final evacuation."
    ],
